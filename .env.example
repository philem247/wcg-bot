# Copy to .env and fill in. Run: node --env-file=.env index.js

# Bot's own WhatsApp number. Country code + number, digits only, no + and no spaces.
PHONE_NUMBER=2340000000000

# Bot owner. Full control everywhere, in every group. Same format.
OWNER=2340000000000

# Extra global admins, comma-separated, same digits-only format.
# Group admins already control the bot inside their own group without being listed here.
ADMINS=

# Command prefix.
PREFIX=/

# trace | debug | info | warn | error
LOG_LEVEL=info

# baileys' own internal logger (separate from LOG_LEVEL above). Very noisy at
# anything above silent — set to 'debug' only when diagnosing connection/pairing
# problems.
WA_LOG_LEVEL=silent

# libsignal writes decrypt-failure/session-reset noise straight to the console,
# bypassing pino. Expected after re-pairing (old sessions vs. new device identity,
# resolves itself via retry receipts) — harmless but floods the terminal. true
# (default) drops just those known lines; set to false to see the raw output
# when debugging a real connection problem.
QUIET_SIGNAL_NOISE=true

# Where WhatsApp credentials are stored. THIS FOLDER IS YOUR SESSION.
# Back it up over SFTP before any panel reinstall — losing it logs the bot out.
SESSION_DIR=session

# Alternatively, set SESSION_ID to the base64 string printed after pairing
# to use SQLite-backed auth instead of the session folder (like Levanter).
# SESSION_ID=
